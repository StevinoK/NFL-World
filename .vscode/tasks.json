{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sim: dashboard",
      "type": "process",
      "command": "${workspaceFolder}\\NFL.venv\\Scripts\\python.exe",
      "args": ["-m", "nflsim.dashboard.run"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Sim: ridge explorer",
      "type": "process",
      "command": "${workspaceFolder}\\NFL.venv\\Scripts\\python.exe",
      "args": ["-m", "streamlit", "run", "nflsim/ridge/explorer.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Sim: DFS dashboard",
      "type": "process",
      "command": "${workspaceFolder}\\NFL.venv\\Scripts\\python.exe",
      "args": ["-m", "nflsim.dfs.run"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Sim: tests",
      "type": "process",
      "command": "${workspaceFolder}\\NFL.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "nflsim/tests", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Player value: weekly update",
      "type": "process",
      "command": "${workspaceFolder}\\NFL_PM.venv\\Scripts\\python.exe",
      "args": ["-m", "player_value.plus_minus"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Player value: explorer",
      "type": "process",
      "command": "${workspaceFolder}\\NFL_PM.venv\\Scripts\\python.exe",
      "args": ["-m", "player_value.run_explorer"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Player value: tests",
      "type": "process",
      "command": "${workspaceFolder}\\NFL_PM.venv\\Scripts\\python.exe",
      "args": ["-m", "unittest", "discover", "-s", "player_value/tests", "-t", ".", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
